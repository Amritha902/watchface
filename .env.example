# Copy to .env and fill in. Every key is optional: without one, Encore falls back
# to its built-in generator so the demo always works.

# Claude — turns a favourite character into a style card (palette, props, mood, image prompt)
ANTHROPIC_API_KEY=

# Replicate — paints the wallpaper from the style card (Flux)
REPLICATE_API_TOKEN=
REPLICATE_MODEL=black-forest-labs/flux-schnell

# TMDB — live character lists for any show (free key at themoviedb.org)
TMDB_API_KEY=

PORT=8787
